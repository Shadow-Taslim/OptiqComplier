-- Optiq showcase: variables, loops, conditions, and SQL together
let minimum = 60000;
while (minimum < 80000) {
    minimum = minimum + 5000;
}

let report = SELECT e.name AS employee_name, d.dept_name AS department, e.salary
    FROM employees e
    INNER JOIN departments d ON e.dept_id = d.id
    WHERE e.salary >= minimum AND d.location = 'HQ'
    ORDER BY e.salary DESC
    LIMIT 5;

if (COUNT(report) > 0) {
    print('matches found');
    print(report);
} else {
    print('no matches');
}
